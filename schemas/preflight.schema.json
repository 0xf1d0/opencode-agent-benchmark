{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Level 1 owner-driven preflight record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model_id",
    "protocol_track",
    "runtime_lock_sha256",
    "performed_by",
    "authentication",
    "checks",
    "os_boundary_verified",
    "effective_configuration_sha256",
    "observed_provider",
    "observed_model_id",
    "scored_ready",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Owner-driven preflight contract version."
    },
    "provider": {
      "enum": [
        "nvidia",
        "mistral",
        "albert",
        "aristote"
      ],
      "description": "Fixed project provider ID, preserved in every workspace."
    },
    "model_id": {
      "type": "string",
      "description": "Exact canonical provider model ID; Albert aliases are forbidden.",
      "minLength": 1
    },
    "protocol_track": {
      "enum": [
        "restricted",
        "agentic"
      ],
      "description": "Restricted and agentic are distinct estimands; agentic remains design-only."
    },
    "runtime_lock_sha256": {
      "type": [
        "string",
        "null"
      ],
      "description": "Exact lock identifying the runtime/config/evidence tested.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "performed_by": {
      "enum": [
        "repository_owner",
        null
      ],
      "description": "Human owner performing authenticated qualification; null for the unperformed template."
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "description": "Credential backend deliberately excluded.",
      "required": [
        "mode",
        "provider_id",
        "credential_storage_location",
        "credential_storage_location_verified",
        "credential_present_usable"
      ],
      "properties": {
        "mode": {
          "const": "opencode_managed_persistent_credential",
          "description": "External private OpenCode-managed authentication."
        },
        "provider_id": {
          "enum": [
            "nvidia",
            "mistral",
            "albert",
            "aristote"
          ],
          "description": "Fixed project provider ID, preserved in every workspace."
        },
        "credential_storage_location": {
          "type": "null",
          "description": "Never discover or record private storage location."
        },
        "credential_storage_location_verified": {
          "const": false,
          "description": "Storage implementation is outside the benchmark."
        },
        "credential_present_usable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Owner-observed usability only, null before inference qualification."
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Nine separate runtime observations; catalog membership does not satisfy them.",
      "required": [
        "project_configuration_loads",
        "provider_visible",
        "canonical_model_visible",
        "inference_succeeds",
        "trivial_conversation_succeeds",
        "required_tool_calling_works",
        "permissions_enforced",
        "context_output_configuration_accepted",
        "no_unintended_fallback"
      ],
      "properties": {
        "project_configuration_loads": {
          "title": "Preflight check",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "observed_at",
            "evidence_sha256",
            "notes"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_run",
                "passed",
                "failed",
                "unverified"
              ],
              "description": "A not-run or uncertain check never implies success."
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "Observed UTC time of the owner-driven check, null before execution.",
              "format": "date-time",
              "pattern": "Z$"
            },
            "evidence_sha256": {
              "type": [
                "string",
                "null"
              ],
              "description": "Hash of sanitized owner-retained evidence, never credential material.",
              "pattern": "^[a-f0-9]{64}$"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "description": "Factual owner observations or reason for an unverified/failed check.",
              "minLength": 1
            }
          },
          "description": "project configuration loads.",
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "passed"
                  }
                }
              },
              "then": {
                "properties": {
                  "observed_at": {
                    "type": "string"
                  },
                  "evidence_sha256": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_run"
                  }
                }
              },
              "then": {
                "properties": {
                  "observed_at": {
                    "type": "null"
