{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {},
  "plugin": [],
  "lsp": false,
  "formatter": false,
  "tools": {
    "webfetch": false,
    "websearch": false,
    "bash": false,
    "task": false,
    "skill": false,
    "lsp": false
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*auth.json": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "*": "allow",
      "*opencode.json": "deny",
      "*opencode.jsonc": "deny",
      ".opencode/*": "deny",
      "*/.opencode/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*auth.json": "deny",
      "*credentials*": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": "deny",
    "task": "deny",
    "skill": "deny",
    "lsp": "deny",
    "external_directory": "deny"
  },
  "model": "mistral/codestral-2508",
  "small_model": "mistral/codestral-2508",
  "enabled_providers": [
    "mistral"
  ],
  "provider": {
    "mistral": {
      "name": "Mistral AI direct",
      "npm": "@ai-sdk/mistral",
      "options": {
        "baseURL": "https://api.mistral.ai/v1"
      },
      "models": {
        "codestral-2508": {
          "name": "codestral-2508",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
