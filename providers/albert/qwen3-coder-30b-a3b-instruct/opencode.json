{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {},
  "plugin": [],
  "lsp": false,
  "formatter": false,
