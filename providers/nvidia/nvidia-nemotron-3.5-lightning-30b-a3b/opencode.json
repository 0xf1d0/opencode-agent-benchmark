{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "mcp": {},
  "plugin": [],
  "lsp": false,
  "formatter": false,
  "tools": {
    "webfetch": false,
    "websearch": false,
    "bash": false,
    "task": false,
    "skill": false,
    "lsp": false
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*auth.json": "deny",
      "*credentials*": "deny"
    },
    "edit": {
      "*": "allow",
      "*opencode.json": "deny",
      "*opencode.jsonc": "deny",
      ".opencode/*": "deny",
      "*/.opencode/*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*auth.json": "deny",
      "*credentials*": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": "deny",
    "task": "deny",
    "skill": "deny",
    "lsp": "deny",
    "external_directory": "deny"
  },
  "model": "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
  "small_model": "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
  "enabled_providers": [
    "nvidia"
  ],
  "provider": {
    "nvidia": {
      "name": "NVIDIA Build",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "nvidia/nemotron-3.5-lightning-30b-a3b": {
          "name": "nvidia/nemotron-3.5-lightning-30b-a3b",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
